{
  "opencollection": "1.0.0",
  "info": {
    "name": "lexoffice (lexware Office) Public Contacts Recurring Templates API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recurring Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List recurring templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lexware.io/v1/recurring-templates",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size (max 250 for most collections)."
              }
            ]
          },
          "docs": "Returns a paged list of recurring templates that generate recurring invoices."
        },
        {
          "info": {
            "name": "Retrieve a recurring template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lexware.io/v1/recurring-templates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The UUID of the resource."
              }
            ]
          },
          "docs": "Retrieve a recurring template"
        }
      ]
    }
  ],
  "bundled": true
}